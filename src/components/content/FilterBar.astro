---
interface Props {
  categories: string[];
  placeholder: string;
}
const { categories, placeholder } = Astro.props;
---

<catalog-filter>
  <div class="search-field">
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="m16 16 5 5" />
    </svg>
    <input type="search" aria-label={placeholder} placeholder={placeholder} />
    <kbd aria-hidden="true">⌘ / Ctrl K</kbd>
  </div>
  <div class="filter-topics" role="group" aria-label="Filter by category">
    {["All", ...categories].map((category) => (
      <button type="button" data-filter-category={category} aria-pressed={category === "All"}>
        {category}
      </button>
    ))}
  </div>
  <p class="filter-status" role="status" aria-live="polite"></p>
  <noscript>
    <p class="filter-status">All entries are shown. Enable JavaScript to search and filter.</p>
  </noscript>
</catalog-filter>

<script>
  class CatalogFilter extends HTMLElement {
    connectedCallback() {
      const catalog = this.closest("[data-filter-catalog]");
      const input = this.querySelector("input");
      const status = this.querySelector('[role="status"]');
      const buttons = this.querySelectorAll<HTMLButtonElement>("[data-filter-category]");
      if (!catalog || !input || !status) return;
      const items = [...catalog.querySelectorAll<HTMLElement>("[data-filter-item]")];
      let category = "All";
      const update = () => {
        const search = input.value.trim().toLocaleLowerCase();
        let visible = 0;
        for (const item of items) {
          const matchesCategory = category === "All" || item.dataset.category === category;
          const matchesSearch = (item.dataset.search ?? item.textContent ?? "")
            .toLocaleLowerCase()
            .includes(search);
          item.hidden = !(matchesCategory && matchesSearch);
          if (!item.hidden) visible++;
        }
        status.textContent = visible
          ? `Showing ${visible} of ${items.length} entries`
          : "No matches. Try another search or category.";
        buttons.forEach((button) =>
          button.setAttribute("aria-pressed", String(button.dataset.filterCategory === category)),
        );
      };
      input.addEventListener("input", update);
      buttons.forEach((button) =>
        button.addEventListener("click", () => {
          category = button.dataset.filterCategory ?? "All";
          update();
        }),
      );
      document.addEventListener("keydown", (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          input.focus();
          input.select();
        }
      });
      update();
    }
  }
  if (!customElements.get("catalog-filter")) customElements.define("catalog-filter", CatalogFilter);
</script>

<style>
  catalog-filter {
    display: block;
    margin-bottom: 2.5rem;
  }
  .search-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-outline);
    border-radius: 90px 8px 80px 7px / 7px 80px 8px 90px;
    background: var(--color-surface-container-lowest);
  }
  .search-field:focus-within {
    outline: 1px solid var(--color-primary);
  }
  input {
    width: 100%;
    min-width: 0;
    background: transparent;
    color: var(--color-on-surface);
    font-size: 1rem;
    outline: none;
  }
  input::placeholder {
    color: var(--color-secondary);
  }
  kbd {
    white-space: nowrap;
    font-family: var(--font-label-mono);
    font-size: 0.6rem;
    color: var(--color-secondary);
  }
  .filter-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  button {
    font-family: var(--font-label-mono);
    font-size: 0.65rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-outline-variant);
    border-radius: 30px 5px 27px 6px / 6px 27px 5px 30px;
    color: var(--color-on-surface-variant);
    cursor: pointer;
  }
  button:hover {
    border-color: var(--color-primary);
  }
  button[aria-pressed="true"] {
    color: var(--color-background);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .filter-status {
    margin-top: 1rem;
    font-family: var(--font-label-mono) !important;
    font-size: 0.65rem;
    color: var(--color-secondary);
  }
  @media (max-width: 400px) {
    kbd {
      display: none;
    }
  }
</style>
