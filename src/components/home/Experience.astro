---
import { skills } from "../../data/profile";
---

<section class="space-y-space-lg pt-space-xs" id="experience" aria-labelledby="experience-heading">
  <div class="space-y-3">
    <h2 id="experience-heading" class="font-headline-md text-headline-md text-on-surface">
      Work experience
    </h2>
  </div>

  <div class="space-y-space-md">
    <article class="content-panel space-y-3">
      <h3 class="font-headline-sm text-headline-sm">Software Engineer</h3>
      <div class="metadata-row justify-between">
        <span>Navigatus · Remote · Melbourne, Australia</span>
        <span>Mar 2025 – Present</span>
      </div>
    </article>

    <article class="content-panel space-y-3">
      <h3 class="font-headline-sm text-headline-sm">Founding Full-Stack Engineer</h3>
      <div class="metadata-row justify-between">
        <span>Mexemy · Cumilla, Bangladesh</span>
        <span>Nov 2022 – Dec 2024</span>
      </div>
    </article>
  </div>

  <section class="space-y-space-md" aria-labelledby="skills-heading">
    <h3 id="skills-heading" class="font-headline-sm text-headline-sm">
      Technical skills
    </h3>
    <dl class="grid gap-space-md sm:grid-cols-2">
      {skills.map(({ label, items }) => (
        <div class="space-y-2">
          <dt class="font-label-mono text-label-mono uppercase tracking-wider text-secondary">
            {label}
          </dt>
          <dd class="font-body-sm text-body-sm text-on-surface-variant">{items.join(" · ")}</dd>
        </div>
      ))}
    </dl>
  </section>
</section>
