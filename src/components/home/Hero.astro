---
import Newsletter from "./Newsletter.astro";
---

<section
  class="sketched-border rounded-lg bg-surface-bright/50 p-space-lg sm:p-space-xl text-center space-y-space-md"
  id="home"
>
  <div aria-hidden="true" class="sketch-corner-tr"></div>
  <div aria-hidden="true" class="sketch-corner-bl"></div>

  <div class="flex justify-center">
    <div class="relative p-0.5 rounded-full border border-outline-variant/60 bg-surface-container-lowest shadow-sm">
      <img
        class="w-14 h-14 rounded-full object-cover object-center grayscale hover:grayscale-0 transition-all duration-300"
        alt="Shahrear Ahamed"
        width="56"
        height="56"
        src="/images/shahrear-ahamed.webp"
      />
      <div
        class="absolute bottom-0 right-0 w-3 h-3 bg-tertiary-fixed-dim rounded-full border-2 border-surface-container-lowest"
        title="Available for projects"
      ></div>
    </div>
  </div>

  <div class="space-y-1">
    <p class="font-headline-sm text-headline-sm italic text-secondary tracking-wide">
      Shahrear Ahamed
    </p>
    <h1 class="font-display-hero text-display-hero text-on-surface leading-tight tracking-tight">
      I build{" "}
      <span class="line-through decoration-outline/60 text-outline-variant font-normal italic">
        features
      </span>
      <br />
      <span class="font-normal tracking-tight">systems that scale.</span>
    </h1>
  </div>

  <p
    id="about"
    class="font-body-md text-body-md text-on-surface-variant max-w-[540px] mx-auto leading-relaxed pt-space-xs"
  >
    Ten years building software that holds up —{" "}
    <strong class="font-medium text-on-surface">scalable systems</strong>, workflows that cut
    friction, and{" "}
    <strong class="font-medium text-on-surface">teams that own what they build</strong>. Lately I
    work at the <strong class="font-medium text-on-surface">AI-native</strong> end: engineering
    products where the model is the substance, not a sprinkle.
  </p>

  <div class="flex justify-center items-center gap-3 pt-space-xs text-on-surface-variant">
    <a
      aria-label="GitHub"
      class="p-1.5 hover:text-primary transition-colors active:scale-[0.98]"
      href="https://github.com/shahrear-ahamed"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
      </svg>
    </a>
    <a
      aria-label="X / Twitter"
      class="p-1.5 hover:text-primary transition-colors active:scale-[0.98]"
      href="https://x.com"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
      </svg>
    </a>
    <a
      aria-label="LinkedIn"
      class="p-1.5 hover:text-primary transition-colors active:scale-[0.98]"
      href="https://linkedin.com"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
      </svg>
    </a>
    <a
      aria-label="Email"
      class="p-1.5 hover:text-primary transition-colors active:scale-[0.98]"
      href="mailto:contact@shahrear.dev"
    >
      <span class="material-symbols-outlined text-[17px]">mail</span>
    </a>
  </div>

  <Newsletter />
</section>
