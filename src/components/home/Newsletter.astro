<div class="pt-space-md border-t border-outline-variant/30 max-w-[460px] mx-auto space-y-3">
  <div class="space-y-1">
    <p class="font-body-sm text-body-sm text-on-surface font-medium">
      Curated engineering notes, straight to your inbox.
    </p>
    <p class="font-label-mono text-label-mono text-secondary">
      An occasional dispatch. Thoughtfully written.
    </p>
  </div>
  <p id="newsletter-status" role="status" class="font-label-mono text-label-mono"></p>
  <form
    class="flex items-center gap-1.5 p-1 bg-surface-container-lowest border border-outline-variant/70 rounded-full focus-within:border-primary transition-colors wobbly-pill"
    id="newsletter-form"
  >
    <div class="pl-3 pr-1 text-on-surface-variant flex items-center">
      <span class="material-symbols-outlined text-[16px]">alternate_email</span>
    </div>
    <input
      class="w-full bg-transparent border-none text-body-sm font-body-sm text-on-surface placeholder:text-outline-variant focus:ring-0 focus:outline-none py-1 px-1"
      aria-label="Email address"
      placeholder="Enter your email"
      required=""
      type="email"
    />
    <button
      class="px-4 py-1.5 rounded-full bg-primary-container text-on-primary font-nav-link text-nav-link hover:opacity-90 active:scale-[0.98] transition-all shrink-0"
      type="submit"
    >
      Subscribe
    </button>
  </form>
  <p class="font-label-mono text-label-mono text-on-surface-variant/80 tracking-normal">
    Newsletter coming soon. Your email is not collected yet.
  </p>
</div>

<script>
  document.querySelector("#newsletter-form")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const status = document.querySelector("#newsletter-status");
    if (status) status.textContent = "Subscriptions are not open yet. Please check back soon.";
  });
</script>
