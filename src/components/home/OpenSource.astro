---
import { CodeIcon } from "@hugeicons/core-free-icons";
import { getCollection } from "astro:content";
import ProjectCard from "../ui/ProjectCard.astro";
const projects = (await getCollection("projects"))
  .sort((a, b) => a.id.localeCompare(b.id))
  .slice(0, 6);
---

<section class="space-y-space-md" id="works">
  <div class="flex items-baseline justify-between border-b border-outline-variant/30 pb-2">
    <h2 class="font-headline-md text-headline-md text-on-surface">Projects</h2>
    <a
      class="font-label-mono text-label-mono text-secondary hover:text-primary uppercase tracking-wider flex items-center gap-0.5"
      href="/projects/"
    >
      ALL PROJECTS →
    </a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm pt-2">
    {projects.map((project) => (
      <ProjectCard
        href={`/projects/${project.id}/`}
        title={project.data.title}
        language={project.data.stack[0] ?? "PROJECT"}
        icon={CodeIcon}
        detail={project.data.category}
      >
        {project.data.description}
      </ProjectCard>
    ))}
  </div>
</section>
