---
import { getCollection } from "astro:content";
import ProjectCard from "../ui/ProjectCard.astro";
const projectEntries = await getCollection("projects");
const pulseDeck = projectEntries.find((entry) =>
  entry.data.title.toLowerCase().startsWith("pulsedeck"),
);
---

<section class="space-y-space-md" id="works">
  <div class="flex items-baseline justify-between border-b border-outline-variant/30 pb-2">
    <h2 class="font-headline-md text-headline-md text-on-surface">Open source</h2>
    <a
      class="font-label-mono text-label-mono text-secondary hover:text-primary uppercase tracking-wider flex items-center gap-0.5"
      href="/projects/"
    >
      ALL PROJECTS →
    </a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm pt-2">
    <ProjectCard
      href="/projects/#glwtpl-public-license"
      title={"GLWTPL"}
      language={"TEXT"}
      icon={"balance"}
      detail={"Permissive"}
    >
      The "Good Luck With That" Public License — a humorous yet poignant software license for code
      you're releasing with zero guarantees.
    </ProjectCard>

    <ProjectCard
      href="/projects/#bangla-programming-resources"
      title={"Bangla Programming Resources"}
      language={"MARKDOWN"}
      icon={"stars"}
      detail={"1.2k stars"}
    >
      Curated list of Bengali tutorials, high-value algorithmic references, and systems engineering
      material across various topics.
    </ProjectCard>

    <ProjectCard
      href="/projects/#devtools-desktop"
      title={"DevTools"}
      language={"TYPESCRIPT"}
      icon={"desktop_windows"}
      detail={"Electron / Tauri"}
    >
      Ultimate developer toolkit desktop utility — fast formatters, regex analyzers, encoders, and
      converters running entirely offline.
    </ProjectCard>

    <ProjectCard
      href={pulseDeck ? `/projects/${pulseDeck.id}/` : "/projects/"}
      title={"PulseDeck"}
      language={"GO"}
      icon={"smart_toy"}
      detail={"LLM Tooling"}
    >
      The real-time inbox for your autonomous AI agents — an aggregated cockpit to review agent
      milestones and flag items needing human review.
    </ProjectCard>

    <ProjectCard
      title={"Laravel Framework"}
      language={"PHP"}
      icon={"lowercase"}
      detail={"Contributor"}
    >
      The PHP framework for web artisans — upstream core contributions focused on queue processing
      and database drivers.
    </ProjectCard>

    <ProjectCard
      title={"Symfony VarDumper"}
      language={"PHP"}
      icon={"bug_report"}
      detail={"Core Fixes"}
    >
      Symfony’s foundational variable inspection tool — patch contributed directly to the Symfony
      monorepo.
    </ProjectCard>
  </div>
</section>
