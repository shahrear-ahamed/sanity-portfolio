---
import { getCollection } from "astro:content";

const posts = (await getCollection("blogs"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
const dateLabel = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
---

<section class="space-y-space-md" id="blogs">
  <div class="space-y-space-md">
    <div class="flex items-baseline justify-between border-b border-outline-variant/30 pb-2">
      <h3 class="font-headline-sm text-headline-sm text-on-surface">Latest posts</h3>
      <a
        class="font-label-mono text-label-mono text-secondary hover:text-primary uppercase tracking-wider flex items-center gap-0.5"
        href="/blogs/"
      >
        ALL POSTS →
      </a>
    </div>
    <ul class="space-y-4">
      {posts.map((post, index) => (
        <li class="group pb-3 relative">
          <time
            datetime={post.data.date.toISOString().slice(0, 10)}
            class="font-label-mono text-label-mono text-secondary uppercase block mb-0.5"
          >
            {dateLabel(post.data.date)}
          </time>
          <a
            class="font-headline-sm text-[1.125rem] text-on-surface group-hover:underline decoration-outline-variant decoration-1 underline-offset-4 transition-all block"
            href={`/blogs/${post.id}/`}
          >
            {post.data.title}
          </a>
          <p class="mt-2 font-body-sm text-body-sm text-on-surface-variant line-clamp-2">
            {post.data.description}
          </p>
          {index < posts.length - 1 && (
            <div class="w-full hand-wavy-stroke pt-2.5 overflow-hidden">
              <svg
                class="w-full h-2 stroke-current"
                fill="none"
                preserveAspectRatio="none"
                viewBox="0 0 600 6"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M0 3.2 Q 40 1.0, 80 3.5 T 160 2.6 T 240 3.9 T 320 2.4 T 400 3.7 T 480 2.5 T 560 3.8 T 600 3.0"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.3"
                />
              </svg>
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
