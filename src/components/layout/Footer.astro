---
import { profile } from "../../data/profile";
---

<footer class="docked full-width bottom bg-surface-container-low border-outline-variant/30">
  <div aria-hidden="true" class="w-full hand-wavy-stroke overflow-hidden pointer-events-none">
    <svg
      class="w-full h-3 stroke-current block"
      fill="none"
      preserveAspectRatio="none"
      viewBox="0 0 1200 12"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0 5.8 C 75 8.9, 150 2.9, 230 6.2 C 310 9.1, 390 2.8, 475 5.9 C 560 8.8, 640 3.0, 725 6.3 C 810 9.0, 895 2.7, 980 5.7 C 1060 8.7, 1130 3.3, 1200 6.0"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.35"
      ></path>
    </svg>
  </div>
  <div class="flex flex-col sm:flex-row justify-between items-center max-w-185 mx-auto px-margin-desktop py-space-lg w-full gap-space-md">
    <p class="text-body-sm font-body-sm text-on-surface-variant">
      © <span id="copyright-year">{new Date().getFullYear()}</span> Shahrear Ahamed. Built with
      craftsmanship and care.
    </p>

    <div class="flex items-center space-x-6 text-label-mono font-label-mono">
      <a
        class="text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors duration-150 active:scale-[0.98]"
        href={profile.github}
        rel="noreferrer"
        target="_blank"
      >
        GitHub
      </a>
      <a
        class="text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors duration-150 active:scale-[0.98]"
        href={profile.linkedin}
        rel="noreferrer"
        target="_blank"
      >
        LinkedIn
      </a>
      <a
        class="text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors duration-150 active:scale-[0.98]"
        href="#main-content"
      >
        Back to top
      </a>
    </div>
  </div>
</footer>

<script>
  const yearElement = document.getElementById("copyright-year");
  const currentYear = String(new Date().getFullYear());
  if (yearElement && yearElement.textContent !== currentYear) {
    yearElement.textContent = currentYear;
  }
</script>
