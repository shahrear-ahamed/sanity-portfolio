---
import { profile } from "../../data/profile";
---

<footer class="docked full-width bottom">
  <div aria-hidden="true" class="w-full px-0! hand-wavy-stroke overflow-hidden pointer-events-none">
    <svg
      class="w-full h-5 block"
      fill="none"
      preserveAspectRatio="none"
      viewBox="0 0 1200 20"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0 20 L0 10.0 C 75 17.4, 150 2.6, 225 9.8 C 300 17.2, 375 2.4, 455 10.2 C 535 17.6, 610 2.8, 690 9.7 C 770 17.0, 845 2.5, 925 10.1 C 1005 17.4, 1085 2.8, 1160 9.6 C 1178 11.2, 1190 10.6, 1200 10.0 L1200 20 Z"
        fill="var(--color-surface-container-low)"
      ></path>
      <path
        class="stroke-current"
        d="M0 10.0 C 75 17.4, 150 2.6, 225 9.8 C 300 17.2, 375 2.4, 455 10.2 C 535 17.6, 610 2.8, 690 9.7 C 770 17.0, 845 2.5, 925 10.1 C 1005 17.4, 1085 2.8, 1160 9.6 C 1178 11.2, 1190 10.6, 1200 10.0"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.4"
      ></path>
    </svg>
  </div>
  <div class="w-full px-0! bg-surface-container-low">
    <div class="flex flex-col sm:flex-row justify-between items-center max-w-185 mx-auto px-5 sm:px-margin-desktop py-space-lg w-full gap-space-md">
      <p class="text-body-sm font-body-sm text-on-surface-variant">
        © <span id="copyright-year">{new Date().getFullYear()}</span> Shahrear Ahamed. Built with
        craftsmanship and care.
      </p>

      <div class="flex items-center space-x-6 text-label-mono font-label-mono">
        <a
          class="text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors duration-150 active:scale-[0.98]"
          href={profile.github}
          rel="noreferrer"
          target="_blank"
        >
          GitHub
        </a>
        <a
          class="text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors duration-150 active:scale-[0.98]"
          href={profile.linkedin}
          rel="noreferrer"
          target="_blank"
        >
          LinkedIn
        </a>
        <a
          class="text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors duration-150 active:scale-[0.98]"
          href="#main-content"
        >
          Back to top
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  const yearElement = document.getElementById("copyright-year");
  const currentYear = String(new Date().getFullYear());
  if (yearElement && yearElement.textContent !== currentYear) {
    yearElement.textContent = currentYear;
  }
</script>
