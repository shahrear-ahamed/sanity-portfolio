---
import { profile } from "../../data/profile";
---

<div class="max-w-185 mx-auto px-margin-desktop w-full overflow-hidden hand-wavy-stroke">
  <svg
    class="w-full h-2.5 stroke-current"
    fill="none"
    preserveAspectRatio="none"
    viewBox="0 0 1200 8"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M0 4.0 Q 80 1.2, 160 4.4 T 320 3.0 T 480 5.0 T 640 2.8 T 800 4.8 T 960 3.0 T 1120 4.6 T 1200 3.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.4"
    ></path>
  </svg>
</div>
<footer class="docked full-width bottom bg-surface-container-low border-outline-variant/30">
  <div class="w-full hand-wavy-stroke overflow-hidden">
    <svg
      class="w-full h-2.5 stroke-current"
      fill="none"
      preserveAspectRatio="none"
      viewBox="0 0 1200 8"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0 3.6 Q 90 5.4, 180 3.2 T 360 4.9 T 540 2.8 T 720 5.1 T 900 3.2 T 1080 4.8 T 1200 3.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.4"
      ></path>
    </svg>
  </div>
  <div class="flex flex-col sm:flex-row justify-between items-center max-w-185 mx-auto px-margin-desktop py-space-lg w-full gap-space-md">
    <p class="text-body-sm font-body-sm text-on-surface-variant">
      © {new Date().getFullYear()} Shahrear Ahamed. Built with craftsmanship and care.
    </p>

    <div class="flex items-center space-x-6 text-label-mono font-label-mono">
      <a
        class="text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors duration-150 active:scale-[0.98]"
        href={profile.github}
        rel="noreferrer"
        target="_blank"
      >
        GitHub
      </a>
      <a
        class="text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors duration-150 active:scale-[0.98]"
        href={profile.linkedin}
        rel="noreferrer"
        target="_blank"
      >
        LinkedIn
      </a>
      <span
        class="text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors duration-150 active:scale-[0.98]"
        title="Coming soon"
      >
        RSS
      </span>
      <a
        class="text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors duration-150 active:scale-[0.98]"
        href="#main-content"
      >
        Back to top
      </a>
    </div>
  </div>
</footer>
