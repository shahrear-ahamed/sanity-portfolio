---
import { Github01Icon } from "@hugeicons/core-free-icons";
import Icon from "../ui/Icon.astro";
import { profile } from "../../data/profile";
import ThemeToggle from "../ui/ThemeToggle.astro";
const pathname = Astro.url.pathname;
const navigation = [
  { label: "/home", href: "/#home", active: pathname === "/" },
  { label: "/blogs", href: "/blogs/", active: pathname.startsWith("/blogs") },
  { label: "/projects", href: "/projects/", active: pathname.startsWith("/projects") },
  { label: "/about", href: "/#experience", active: false },
];
---

<header class="docked full-width top-0 sticky z-50 bg-surface/90 backdrop-blur-md border-outline-variant/30">
  <div class="flex flex-wrap gap-y-4 justify-between items-center max-w-185 mx-auto px-margin-desktop py-space-sm w-full">
    <a
      class="font-headline-sm text-headline-sm text-on-surface tracking-tight font-medium active:scale-[0.98] transition-transform duration-100"
      href="/#home"
    >
      Shahrear Ahamed
    </a>

    <nav
      aria-label="Main navigation"
      class="flex flex-wrap justify-center items-center gap-3 order-3 w-full md:order-0 md:w-auto"
    >
      {navigation.map(({ label, href, active }) => (
        <a
          class:list={[
            "text-nav-link font-nav-link pb-0.5 transition-colors duration-150",
            active
              ? "text-primary border-b border-primary"
              : "text-on-surface-variant hover:text-on-surface",
          ]}
          href={href}
          aria-current={active ? "page" : undefined}
        >
          {label}
        </a>
      ))}
    </nav>

    <div class="flex items-center space-x-2.5">
      <ThemeToggle />
      <span
        class="cursor-pointer px-2.5 py-1 rounded-full border border-outline-variant/60 text-nav-link font-nav-link text-on-surface hover:border-outline hover:text-primary transition-colors duration-150 active:scale-[0.98]"
        title="Coming soon"
      >
        RSS
      </span>
      <a
        aria-label="GitHub"
        class="w-8 h-8 shrink-0 flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors duration-150 active:scale-[0.98]"
        href={profile.github}
        rel="noreferrer"
        target="_blank"
      >
        <Icon icon={Github01Icon} />
      </a>
    </div>
  </div>
</header>
<div class="w-full sticky top-14.25 z-40 hand-wavy-stroke overflow-hidden pointer-events-none">
  <svg
    class="w-full h-2 stroke-current"
    fill="none"
    preserveAspectRatio="none"
    viewBox="0 0 1200 6"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M0 3 Q 75 1.5, 150 3.2 T 300 2.8 T 450 3.3 T 600 2.7 T 750 3.4 T 900 2.6 T 1050 3.2 T 1200 2.9"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.2"
    ></path>
  </svg>
</div>
