---
import { Github01Icon } from "@hugeicons/core-free-icons";
import Icon from "../ui/Icon.astro";
import { profile } from "../../data/profile";
import ThemeToggle from "../ui/ThemeToggle.astro";

const pathname = Astro.url.pathname;
const navigation = [
  { label: "/home", href: "/#home", active: pathname === "/" },
  { label: "/blogs", href: "/blogs/", active: pathname.startsWith("/blogs") },
  { label: "/projects", href: "/projects/", active: pathname.startsWith("/projects") },
  { label: "/experience", href: "/#experience", active: false },
];
---

<header class="docked full-width top-0 sticky z-50 w-full">
  <div class="w-full px-0! bg-surface/90 backdrop-blur-md">
    <div class="site-header-inner w-full max-w-185 mx-auto px-5 sm:px-margin-desktop py-2.5 md:py-3">
      <a
        class="site-header-brand font-headline-sm text-headline-sm text-on-surface tracking-tight font-medium active:scale-[0.98] transition-transform duration-100"
        href="/#home"
      >
        Shahrear Ahamed
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="site-navigation-panel"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div id="site-navigation-panel" class="site-header-panel">
        <nav aria-label="Main navigation" id="site-navigation" class="site-header-nav">
          {navigation.map(({ label, href, active }) => (
            <a
              class:list={[
                "site-header-link text-nav-link font-nav-link transition-colors duration-150",
                active ? "is-active text-primary" : "text-on-surface-variant hover:text-on-surface",
              ]}
              href={href}
              aria-current={active ? "page" : undefined}
            >
              {label}
            </a>
          ))}
        </nav>

        <div class="site-header-tools">
          <ThemeToggle />
          <a
            aria-label="GitHub"
            class="site-tool-github w-9 h-9 shrink-0 rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors duration-150 active:scale-[0.98]"
            href={profile.github}
            rel="noreferrer"
            target="_blank"
          >
            <Icon icon={Github01Icon} />
          </a>
        </div>
      </div>
    </div>
  </div>

  <div aria-hidden="true" class="w-full px-0! hand-wavy-stroke overflow-hidden pointer-events-none">
    <svg
      class="w-full h-5 block"
      fill="none"
      preserveAspectRatio="none"
      viewBox="0 0 1200 20"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0 0 L1200 0 L1200 9.5 C 1130 2.5, 1060 17.5, 985 10.2 C 910 2.8, 835 17.2, 760 9.6 C 685 2.4, 610 17.6, 535 10.0 C 460 2.6, 385 17.4, 310 9.8 C 235 2.4, 160 17.5, 85 10.1 C 45 6.2, 20 8.5, 0 10.0 Z"
        fill="var(--color-surface)"
        fill-opacity="0.9"
      ></path>
      <path
        class="stroke-current"
        d="M0 10.0 C 20 8.5, 45 6.2, 85 10.1 C 160 17.5, 235 2.4, 310 9.8 C 385 17.4, 460 2.6, 535 10.0 C 610 17.6, 685 2.4, 760 9.6 C 835 17.2, 910 2.8, 985 10.2 C 1060 17.5, 1130 2.5, 1200 9.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.4"
      ></path>
    </svg>
  </div>
</header>

<style>
  .site-header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
  }

  .site-header-brand {
    white-space: nowrap;
    font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    justify-self: start;
  }

  .menu-toggle {
    display: flex;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.7rem;
    border: 1px solid var(--color-outline-variant);
    border-radius: 9999px;
    background: transparent;
    color: var(--color-on-surface);
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    justify-self: end;
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .menu-toggle:hover {
    border-color: var(--color-outline);
    background-color: var(--color-surface-container);
  }

  .menu-toggle span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 150ms ease,
      opacity 150ms ease;
  }

  .menu-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(5.5px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* Mobile (< 768px): everything lives inside the collapsible hamburger list */
  .site-header-panel {
    display: none;
    grid-column: 1 / -1;
    width: 100%;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    padding: 0.75rem 0 0.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
  }

  .site-header-panel.is-open {
    display: flex;
  }

  .site-header-nav {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    gap: 0.25rem;
  }

  .site-header-link {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .site-header-link:hover {
    background-color: var(--color-surface-container-low);
  }

  .site-header-link.is-active {
    background-color: var(--color-surface-container);
    font-weight: 500;
  }

  .site-header-tools {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    gap: 0.75rem;
    padding: 0.75rem 0.75rem 0.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-outline-variant) 45%, transparent);
  }

  /* Tablet (768px - 1023px): single row aligned with content container */
  @media (min-width: 768px) {
    .site-header-inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
      column-gap: 1.25rem;
    }

    .menu-toggle {
      display: none;
    }

    .site-header-panel {
      display: contents;
      border-top: 0;
      padding: 0;
    }

    .site-header-nav {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      width: auto;
      gap: 0.375rem;
    }

    .site-header-link {
      width: auto;
      min-height: auto;
      padding: 0.25rem 0.375rem;
      border-radius: 0;
      display: inline-flex;
      justify-content: center;
    }

    .site-header-link:hover {
      background-color: transparent;
    }

    .site-header-link.is-active {
      background-color: transparent;
      border-bottom: 1px solid var(--color-primary);
    }

    .site-header-tools {
      width: auto;
      justify-content: flex-end;
      gap: 0.5rem;
      padding: 0;
      border-top: 0;
    }
  }

  /* Laptop (1024px - 1279px) */
  @media (min-width: 1024px) {
    .site-header-inner {
      column-gap: 1.75rem;
    }

    .site-header-nav {
      gap: 0.5rem;
    }

    .site-header-link {
      padding: 0.25rem 0.5rem;
    }

    .site-header-tools {
      gap: 0.625rem;
    }
  }

  /* Desktop (>= 1280px) */
  @media (min-width: 1280px) {
    .site-header-inner {
      column-gap: 2rem;
    }

    .site-header-nav {
      gap: 0.75rem;
    }

    .site-header-tools {
      gap: 0.625rem;
    }
  }
</style>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigationPanel = document.querySelector<HTMLElement>("#site-navigation-panel");

  if (menuButton && navigationPanel) {
    const setMenuOpen = (open: boolean) => {
      menuButton.setAttribute("aria-expanded", String(open));
      menuButton.setAttribute(
        "aria-label",
        open ? "Close navigation menu" : "Open navigation menu",
      );
      navigationPanel.classList.toggle("is-open", open);
    };

    menuButton.addEventListener("click", () => {
      const isOpen = menuButton.getAttribute("aria-expanded") === "true";
      setMenuOpen(!isOpen);
    });

    navigationPanel.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) {
        setMenuOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menuButton.getAttribute("aria-expanded") === "true") {
        setMenuOpen(false);
        menuButton.focus();
      }
    });

    const tabletMedia = window.matchMedia("(min-width: 768px)");
    tabletMedia.addEventListener("change", (event) => {
      if (event.matches) {
        setMenuOpen(false);
      }
    });
  }
</script>
