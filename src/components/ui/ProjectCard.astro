---
import type { Github01Icon } from "@hugeicons/core-free-icons";
import Icon from "./Icon.astro";
interface Props {
  title: string;
  href?: string;
  language: string;
  icon: typeof Github01Icon;
  detail: string;
}
const { title, href, language, icon, detail } = Astro.props;
---

<article class="p-4 rounded-lg border border-outline-variant/50 bg-surface-container-lowest/70 hover:border-outline transition-all duration-150 flex flex-col justify-between group active:scale-[0.99] wobbly-card">
  <div class="space-y-2">
    <div class="flex items-center justify-between">
      <h3 class="font-body-md font-semibold text-on-surface group-hover:text-primary">
        {href ? (
          <a href={href} class="hover:underline underline-offset-4">
            {title}
          </a>
        ) : (
          title
        )}
      </h3>
      <span class="font-label-mono text-[10px] uppercase px-1.5 py-0.5 rounded bg-surface-container text-secondary tracking-wider">
        {language}
      </span>
    </div>
    <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
      <slot />
    </p>
  </div>
  <div class="pt-3 flex items-center gap-2 text-label-mono text-secondary font-label-mono">
    <Icon icon={icon} size={13} />
    <span>{detail}</span>
  </div>
</article>
