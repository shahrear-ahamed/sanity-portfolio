---
import { getCollection, render, type CollectionEntry } from "astro:content";
// import Newsletter from "../../components/ui/Newsletter.astro";
import SketchDivider from "../../components/ui/SketchDivider.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blogs");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blogs">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, author, category, words, subtitle } = post.data;
const wordLabel = words ?? `~${(post.body ?? "").trim().split(/\s+/).filter(Boolean).length} words`;
const formatDate = (value: Date) =>
  new Intl.DateTimeFormat("en", { dateStyle: "medium", timeZone: "UTC" }).format(value);
---

<SiteLayout title={`${title} — Shahrear Ahamed`} description={description}>
  <header class="page-intro">
    <a class="back-link" href="/blogs/">
      ← All posts
    </a>
    <div class="metadata-row">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {updated && (
        <span>
          Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
        </span>
      )}
    </div>
    <h1>{title}</h1>
    {subtitle && <p class="page-lead">{subtitle}</p>}
    <div class="metadata-row">
      <span>{author}</span>
      <span>{wordLabel}</span>
      <span class="tag">{category}</span>
    </div>
  </header>
  <SketchDivider />
  <article class="content-panel editorial-prose" aria-label={title}>
    <Content />
  </article>
  <SketchDivider />
  {/* <Newsletter /> */}
  <a class="back-link" href="/blogs/">
    ← Back to all writing
  </a>
</SiteLayout>
